# Generates a C++ source that embeds a network file as a byte array.
#
#   cmake -DINPUT=<file or empty> -DOUTPUT=<generated.cpp> -P embed_net.cmake
#
# With no INPUT the array is empty and the engine falls back to its
# hand-crafted evaluation.

if(INPUT AND EXISTS "${INPUT}")
  file(READ "${INPUT}" HEX_CONTENT HEX)
  string(LENGTH "${HEX_CONTENT}" HEX_LENGTH)
  math(EXPR BYTE_COUNT "${HEX_LENGTH} / 2")
  # Turn "0a1b2c" into "0x0a,0x1b,0x2c," in chunks to keep the regex fast.
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARRAY "${HEX_CONTENT}")
  set(CONTENT "// Generated by cmake/embed_net.cmake from ${INPUT}. Do not edit.
#include <cstddef>
extern \"C\" {
extern const unsigned char gSuperpawnEmbeddedNet[];
extern const std::size_t   gSuperpawnEmbeddedNetSize;
alignas(64) const unsigned char gSuperpawnEmbeddedNet[] = {${ARRAY}};
const std::size_t gSuperpawnEmbeddedNetSize = ${BYTE_COUNT};
}
")
else()
  set(CONTENT "// Generated by cmake/embed_net.cmake. No network embedded.
#include <cstddef>
extern \"C\" {
extern const unsigned char gSuperpawnEmbeddedNet[];
extern const std::size_t   gSuperpawnEmbeddedNetSize;
const unsigned char gSuperpawnEmbeddedNet[1] = {0};
const std::size_t   gSuperpawnEmbeddedNetSize = 0;
}
")
endif()

# Only rewrite when changed so that incremental builds stay incremental.
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" OLD)
  if(OLD STREQUAL CONTENT)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${CONTENT}")
