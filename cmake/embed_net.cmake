# Generates a C++ source that embeds a network file as a byte array.
#
#   cmake -DINPUT=<file> [-DFALLBACK=<file>] -DOUTPUT=<generated.cpp> -P embed_net.cmake
#
# INPUT is the local candidate (nets/default.nnue); when it does not exist the
# FALLBACK, the released network named in nets/NETWORK, is embedded instead.
#
# Runs on every build. The file is re-read only when its size or timestamp
# changed since the last run (recorded in OUTPUT.stamp), and the output is
# only rewritten when its content changed, so incremental builds stay
# incremental. With no INPUT, or an INPUT that does not exist, the array is
# empty and the engine falls back to its hand-crafted evaluation.

if(NOT (INPUT AND EXISTS "${INPUT}") AND FALLBACK AND EXISTS "${FALLBACK}")
  set(INPUT "${FALLBACK}")
endif()

if(INPUT AND EXISTS "${INPUT}")
  file(SIZE "${INPUT}" NET_SIZE)
  file(TIMESTAMP "${INPUT}" NET_TIME "%Y-%m-%dT%H:%M:%S" UTC)
  set(STAMP "${INPUT} ${NET_SIZE} ${NET_TIME}")
else()
  set(STAMP "none")
endif()

if(EXISTS "${OUTPUT}.stamp" AND EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}.stamp" OLD_STAMP)
  if(OLD_STAMP STREQUAL STAMP)
    return()
  endif()
endif()

if(NOT STAMP STREQUAL "none")
  message(STATUS "Embedding NNUE network ${INPUT} (${NET_SIZE} bytes)")
  file(READ "${INPUT}" HEX_CONTENT HEX)
  string(LENGTH "${HEX_CONTENT}" HEX_LENGTH)
  math(EXPR BYTE_COUNT "${HEX_LENGTH} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARRAY "${HEX_CONTENT}")
  set(CONTENT "// Generated by cmake/embed_net.cmake from ${INPUT}. Do not edit.
#include <cstddef>
extern \"C\" {
extern const unsigned char gSuperpawnEmbeddedNet[];
extern const std::size_t   gSuperpawnEmbeddedNetSize;
alignas(64) const unsigned char gSuperpawnEmbeddedNet[] = {${ARRAY}};
const std::size_t gSuperpawnEmbeddedNetSize = ${BYTE_COUNT};
}
")
else()
  message(STATUS "No NNUE network to embed (looked for ${INPUT})")
  set(CONTENT "// Generated by cmake/embed_net.cmake. No network embedded.
#include <cstddef>
extern \"C\" {
extern const unsigned char gSuperpawnEmbeddedNet[];
extern const std::size_t   gSuperpawnEmbeddedNetSize;
const unsigned char gSuperpawnEmbeddedNet[1] = {0};
const std::size_t   gSuperpawnEmbeddedNetSize = 0;
}
")
endif()

# Only rewrite when changed so that the object file is not rebuilt needlessly.
set(WRITE TRUE)
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" OLD)
  if(OLD STREQUAL CONTENT)
    set(WRITE FALSE)
  endif()
endif()
if(WRITE)
  file(WRITE "${OUTPUT}" "${CONTENT}")
endif()
file(WRITE "${OUTPUT}.stamp" "${STAMP}")
